    <link id="dynamicManifest" rel="manifest">

    <!-- تحميل Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- تحميل خط Cairo العربي الحديث -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- أيقونات Lucide -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col select-none sm:select-auto">

    <!-- الشريط العلوي الثابت (Mobile-First App Header) -->
    <header class="bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-30 shadow-xs">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">
            <!-- هوية وأيقونة التطبيق -->
            <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-br from-primary-600 to-blue-800 text-white flex items-center justify-center shadow-md shadow-blue-600/20 shrink-0 relative">
                    <i data-lucide="graduation-cap" class="w-6 h-6"></i>
                    <span class="absolute -bottom-1 -left-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center">
                        <i data-lucide="database" class="w-2.5 h-2.5 text-white"></i>
                    </span>
                </div>
                <div class="truncate">
                    <h1 class="text-base sm:text-xl font-extrabold text-slate-900 leading-tight truncate">شؤون الطلاب</h1>
                    <p class="text-[11px] sm:text-xs text-slate-500 truncate">نظام إدارة السجلات الأكاديمية</p>
                </div>
            </div>
            
            <!-- أزرار الشريط العلوي -->
            <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
                <!-- زر تثبيت التطبيق كأيقونة -->
                <button id="installAppBtn" onclick="handleInstallClick()" class="inline-flex items-center gap-1.5 bg-primary-50 hover:bg-primary-100 text-primary-700 border border-primary-200 text-xs sm:text-sm font-bold px-2.5 sm:px-3.5 py-2 rounded-xl transition active:scale-95">
                    <i data-lucide="smartphone" class="w-4 h-4 text-primary-600"></i>
                    <span class="hidden md:inline">تثبيت التطبيق كأيقونة</span>
                    <span class="md:hidden">تثبيت كأيقونة</span>
                </button>

                <!-- زر تصدير Excel -->
                <button id="exportBtn" onclick="exportToCSV()" class="inline-flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs sm:text-sm font-bold px-2.5 sm:px-3.5 py-2 rounded-xl transition shadow-xs active:scale-95" title="تصدير إلى Excel">
                    <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                    <span class="hidden sm:inline">تصدير Excel</span>
                </button>
            </div>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-7 space-y-5 sm:space-y-6">

        <!-- قسم البطاقات الإحصائية السريعة -->
        <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
            <!-- إجمالي الطلاب -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
                <div>
                    <p class="text-xs sm:text-sm font-semibold text-slate-500">إجمالي الطلاب</p>
                    <p id="statTotalStudents" class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">0</p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                    <i data-lucide="users" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                </div>
            </div>

            <!-- متوسط المعدل -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
                <div>
                    <p class="text-xs sm:text-sm font-semibold text-slate-500">متوسط المعدل</p>
                    <p id="statAvgGrade" class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">0%</p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                    <i data-lucide="bar-chart-3" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                </div>
            </div>

            <!-- أعلى معدل -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
                <div>
                    <p class="text-xs sm:text-sm font-semibold text-slate-500">أعلى معدل</p>
                    <p id="statHighestGrade" class="text-2xl sm:text-3xl font-extrabold text-emerald-600 mt-1">0%</p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                    <i data-lucide="award" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                </div>
            </div>

            <!-- التخصصات -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
                <div>
                    <p class="text-xs sm:text-sm font-semibold text-slate-500">التخصصات</p>
                    <p id="statMajorsCount" class="text-2xl sm:text-3xl font-extrabold text-amber-600 mt-1">0</p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                    <i data-lucide="book-open" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                </div>
            </div>
        </section>

        <!-- الشبكة الرئيسية: نموذج الإدخال + سجل الطلاب -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6 items-start">
            
            <!-- نموذج إدخال وتعديل بيانات الطالب -->
            <section class="lg:col-span-4 bg-white rounded-2xl border border-slate-200/80 shadow-xs p-4 sm:p-6">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center">
                            <i id="formIcon" data-lucide="user-plus" class="w-4 h-4"></i>
                        </div>
                        <h2 id="formTitle" class="text-base sm:text-lg font-bold text-slate-900">إضافة طالب جديد</h2>
                    </div>
                    <button type="button" id="cancelEditBtn" onclick="resetForm()" class="hidden text-xs font-bold text-rose-600 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-xl transition">
                        إلغاء التعديل
                    </button>
                </div>

                <form id="studentForm" class="space-y-3.5">
                    <input type="hidden" id="editStudentId" value="">

                    <!-- الاسم الكامل -->
                    <div>
                        <label for="fullName" class="block text-xs sm:text-sm font-bold text-slate-700 mb-1">الاسم الكامل <span class="text-rose-500">*</span></label>
                        <input type="text" id="fullName" required placeholder="مثال: أحمد محمد علي"
                            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition">
                    </div>

                    <!-- الرقم الأكاديمي -->
                    <div>
                        <label for="studentId" class="block text-xs sm:text-sm font-bold text-slate-700 mb-1">الرقم الأكاديمي <span class="text-rose-500">*</span></label>
                        <input type="text" id="studentId" required placeholder="مثال: 20261045"
                            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition">
                    </div>

                    <!-- المرحلة الدراسية والتخصص -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-3">
                        <div>
                            <label for="gradeLevel" class="block text-xs sm:text-sm font-bold text-slate-700 mb-1">المرحلة الدراسية <span class="text-rose-500">*</span></label>
                            <select id="gradeLevel" required
                                class="w-full px-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition">
                                <option value="" disabled selected>اختر المرحلة</option>
                                <option value="السنة الأولى">السنة الأولى</option>
                                <option value="السنة الثانية">السنة الثانية</option>
                                <option value="السنة الثالثة">السنة الثالثة</option>
                                <option value="السنة الرابعة">السنة الرابعة</option>
                                <option value="دراسات عليا">دراسات عليا</option>
                            </select>
                        </div>

                        <div>
                            <label for="major" class="block text-xs sm:text-sm font-bold text-slate-700 mb-1">التخصص <span class="text-rose-500">*</span></label>
                            <input type="text" id="major" required placeholder="مثال: علوم الحاسوب"
                                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition">
                        </div>
                    </div>

                    <!-- المعدل التراكمي ورقم الهاتف -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-3">
                        <div>
                            <label for="gpa" class="block text-xs sm:text-sm font-bold text-slate-700 mb-1">المعدل التراكمي (%) <span class="text-rose-500">*</span></label>
                            <input type="number" id="gpa" required min="0" max="100" step="0.01" placeholder="89.5"
                                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition">
                        </div>

                        <div>
                            <label for="phone" class="block text-xs sm:text-sm font-bold text-slate-700 mb-1">رقم الهاتف <span class="text-rose-500">*</span></label>
                            <input type="tel" id="phone" required placeholder="0912345678" dir="ltr"
                                class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm text-right focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition">
                        </div>
                    </div>

                    <!-- ملاحظات إضافية -->
                    <div>
                        <label for="notes" class="block text-xs sm:text-sm font-bold text-slate-700 mb-1">ملاحظات (اختياري)</label>
                        <input type="text" id="notes" placeholder="مثال: طالب متفوق / منحة دراسية"
                            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition">
                    </div>

                    <!-- زر الحفظ -->
                    <div class="pt-2">
                        <button type="submit" id="submitBtn"
                            class="w-full flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 text-white font-bold py-3 px-4 rounded-xl shadow-sm transition active:scale-[0.99]">
                            <i data-lucide="save" class="w-4 h-4"></i>
                            <span id="submitBtnText">حفظ بيانات الطالب</span>
                        </button>
                    </div>
                </form>
            </section>

            <!-- قسم سجل الطلاب والبحث وإدارة البيانات -->
            <section class="lg:col-span-8 bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
                <!-- شريط الأدوات والبحث -->
                <div class="p-4 sm:p-5 border-b border-slate-100 space-y-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <h2 class="text-base sm:text-lg font-bold text-slate-900">سجل الطلاب المسجلين</h2>
                            <p class="text-xs text-slate-500 mt-0.5">حفظ تلقائي في ذاكرة الجهاز</p>
                        </div>

                        <!-- أزرار استيراد البيانات التجريبية ومسح السجل -->
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="loadSampleData()" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary-700 bg-primary-50 hover:bg-primary-100 border border-primary-200/80 px-3 py-2 rounded-xl transition active:scale-95">
                                <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                                <span>استيراد بيانات تجريبية</span>
                            </button>
                            <button type="button" onclick="promptClearAll()" class="inline-flex items-center gap-1.5 text-xs font-bold text-rose-600 bg-rose-50 hover:bg-rose-100 border border-rose-200/80 px-3 py-2 rounded-xl transition active:scale-95">
                                <i data-lucide="trash" class="w-3.5 h-3.5"></i>
                                <span>مسح الكل</span>
                            </button>
                        </div>
                    </div>

                    <!-- حقل البحث الفوري والتصفية -->
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
                        <div class="relative flex-grow">
                            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                            <input type="text" id="searchInput" oninput="renderTable()" placeholder="بحث فوري بالاسم، الرقم الأكاديمي، أو التخصص..."
                                class="w-full pr-10 pl-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition">
                        </div>

                        <select id="filterStage" onchange="renderTable()"
                            class="px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm font-medium focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 transition">
                            <option value="all">جميع المراحل الدراسية</option>
                            <option value="السنة الأولى">السنة الأولى</option>
                            <option value="السنة الثانية">السنة الثانية</option>
                            <option value="السنة الثالثة">السنة الثالثة</option>
                            <option value="السنة الرابعة">السنة الرابعة</option>
                            <option value="دراسات عليا">دراسات عليا</option>
                        </select>
                    </div>
                </div>

                <!-- حاوية الجدول المتجاوب -->
                <div class="overflow-x-auto">
                    <table class="w-full text-right border-collapse">
                        <thead>
                            <tr class="bg-slate-50/90 border-b border-slate-200 text-xs font-bold text-slate-600">
                                <th class="py-3.5 px-4">الرقم الأكاديمي</th>
                                <th class="py-3.5 px-4">اسم الطالب</th>
                                <th class="py-3.5 px-4">المرحلة والتخصص</th>
                                <th class="py-3.5 px-4">الهاتف والملاحظات</th>
                                <th class="py-3.5 px-4 text-center">المعدل</th>
                                <th class="py-3.5 px-4 text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="studentsTableBody" class="divide-y divide-slate-100 text-sm">
                            <!-- يتم تعبئة الصفوف ديناميكياً عبر JavaScript -->
                        </tbody>
                    </table>
                </div>

                <!-- حالة عدم وجود بيانات -->
                <div id="emptyState" class="hidden py-12 px-4 text-center">
                    <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-3">
                        <i data-lucide="folder-open" class="w-8 h-8"></i>
                    </div>
                    <h3 class="text-base font-bold text-slate-800">لا توجد سجلات طلاب مطابقة</h3>
                    <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-sm mx-auto">أضف طالباً جديداً من النموذج أو اضغط على زر "استيراد بيانات تجريبية" لتجربة النظام فوراً.</p>
                </div>
            </section>
        </div>
    </main>

    <!-- نافذة إرشادية ذكية لتثبيت التطبيق كأيقونة على الشاشة الرئيسية (Smart PWA Install Guide Modal) -->
    <div id="installGuideModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-5 sm:p-6 shadow-2xl border border-slate-100 transform transition-all max-h-[90vh] overflow-y-auto">
            <!-- رأس النافذة مع معاينة الأيقونة -->
            <div class="flex items-start justify-between gap-4 pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3.5">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary-600 to-blue-800 text-white flex items-center justify-center shadow-lg shadow-blue-600/25 shrink-0 relative">
                        <i data-lucide="graduation-cap" class="w-8 h-8"></i>
                        <span class="absolute -bottom-1 -left-1 w-5 h-5 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center">
                            <i data-lucide="check" class="w-3 h-3 text-white"></i>
                        </span>
                    </div>
                    <div>
                        <span class="inline-block text-[11px] font-bold bg-primary-50 text-primary-700 px-2.5 py-0.5 rounded-full mb-1">تطبيق ويب قابل للتثبيت (PWA)</span>
                        <h3 class="text-lg font-extrabold text-slate-900">تثبيت "شؤون الطلاب" كأيقونة</h3>
                        <p class="text-xs text-slate-500">افتح النظام بنقرة واحدة من شاشتك الرئيسية كأي تطبيق أصلي</p>
                    </div>
                </div>
                <button type="button" onclick="closeInstallModal()" class="p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-xl transition">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- زر التثبيت المباشر التلقائي (يظهر إذا دعم المتصفح beforeinstallprompt) -->
            <div id="nativeInstallSection" class="hidden mt-4 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 flex items-center justify-between gap-3">
                <div>
                    <p class="text-sm font-bold text-emerald-900">التثبيت المباشر متاح على جهازك!</p>
