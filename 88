    <!-- نافذة تأكيد الحذف المخصصة (بدلاً من confirm) -->
    <div id="deleteModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-xs p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100 transform transition-all">
            <div class="flex items-center gap-3 text-rose-600 mb-3">
                <div class="w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center shrink-0">
                    <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                </div>
                <h3 id="deleteModalTitle" class="text-lg font-bold text-slate-900">تأكيد الحذف</h3>
            </div>
            <p id="deleteModalMessage" class="text-sm text-slate-600 leading-relaxed mb-6">
                هل أنت متأكد من رغبتك في حذف هذا السجل؟
            </p>
            <div class="flex items-center justify-end gap-3">
                <button type="button" onclick="closeDeleteModal()" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition">
                    إلغاء
                </button>
                <button type="button" id="confirmDeleteBtn" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-white bg-rose-600 hover:bg-rose-700 shadow-xs transition">
                    نعم، تنفيذ الحذف
                </button>
            </div>
        </div>
    </div>

    <!-- إشعار منبثق (Toast Notification) -->
    <div id="toastContainer" class="fixed bottom-4 left-4 right-4 sm:right-auto sm:left-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- البرمجة والتفاعل -->
    <script>
        const STORAGE_KEY = 'arabic_student_records_pwa_v1';

        // بيانات تجريبية جاهزة للاستيراد
        const sampleStudentsData = [
            {
                id: '1700000101',
                studentId: '20260101',
                fullName: 'سارة عبد الله المنصور',
                gradeLevel: 'السنة الثالثة',
                major: 'هندسة البرمجيات',
                gpa: 95.4,
                phone: '0912345671',
                notes: 'الأولى على الدفعة - منحة تفوق'
            },
            {
                id: '1700000102',
                studentId: '20260102',
                fullName: 'محمد الطيب الحسن',
                gradeLevel: 'السنة الثانية',
                major: 'نظم المعلومات',
                gpa: 84.5,
                phone: '0923456782',
                notes: 'ممثل طلاب الشعبة'
            },
            {
                id: '1700000103',
                studentId: '20260103',
                fullName: 'آمنة يوسف إبراهيم',
                gradeLevel: 'السنة الرابعة',
                major: 'الذكاء الاصطناعي',
                gpa: 91.8,
                phone: '0998765433',
                notes: 'مشروع تخرج متميز'
            },
            {
                id: '1700000104',
                studentId: '20260104',
                fullName: 'عمر الفاروق عثمان',
                gradeLevel: 'السنة الأولى',
                major: 'علوم الحاسوب',
                gpa: 76.0,
                phone: '0911223344',
                notes: ''
            }
        ];

        let students = [];
        let deleteMode = 'single'; // 'single' أو 'all'
        let studentIdToDelete = null;
        let deferredInstallPrompt = null;

        // توليد Web App Manifest ديناميكياً عبر Data URI لدعم التثبيت كأيقونة
        function setupDynamicManifest() {
            const iconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><defs><linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#2563eb"/><stop offset="100%" stop-color="#1e40af"/></linearGradient></defs><rect width="512" height="512" rx="112" fill="url(#g)"/><path d="M256 112L72 196l184 84 150-68.5V312h34V196L256 112z" fill="#ffffff"/><path d="M136 254v78c0 36 54 64 120 64s120-28 120-64v-78l-120 55-120-55z" fill="#dbeafe"/><circle cx="396" cy="376" r="56" fill="#10b981"/><path d="M374 376l15 15 31-31" stroke="#ffffff" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>`;
            const iconDataUri = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(iconSvg);

            const manifestObj = {
                name: 'شؤون الطلاب - نظام إدارة البيانات',
                short_name: 'شؤون الطلاب',
                description: 'تطبيق لإدخال وإدارة سجلات الطلاب والمعدلات الأكاديمية',
                start_url: window.location.href,
                display: 'standalone',
                background_color: '#f8fafc',
                theme_color: '#2563eb',
                dir: 'rtl',
                lang: 'ar',
                icons: [
                    {
                        src: iconDataUri,
                        sizes: '192x192',
                        type: 'image/svg+xml',
                        purpose: 'any maskable'
                    },
                    {
                        src: iconDataUri,
                        sizes: '512x512',
                        type: 'image/svg+xml',
                        purpose: 'any maskable'
                    }
                ]
            };

            const manifestDataUri = 'data:application/manifest+json;charset=utf-8,' + encodeURIComponent(JSON.stringify(manifestObj));
            const manifestLink = document.getElementById('dynamicManifest');
            if (manifestLink) {
                manifestLink.setAttribute('href', manifestDataUri);
            }
        }

        // التقاط حدث التثبيت المباشر في المتصفحات الداعمة
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredInstallPrompt = e;
            const nativeBox = document.getElementById('nativeInstallSection');
            if (nativeBox) nativeBox.classList.remove('hidden');
        });

        // تهيئة التطبيق عند التحميل
        document.addEventListener('DOMContentLoaded', () => {
            setupDynamicManifest();
            detectDeviceTab();
            loadStudents();
            renderTable();
            updateStats();
            lucide.createIcons();
        });

        // تحديد تبويب نظام التشغيل تلقائياً في نافذة التثبيت
        function detectDeviceTab() {
            const ua = navigator.userAgent || '';
            if (/iPad|iPhone|iPod/.test(ua)) {
                switchInstallTab('ios');
            } else if (/Android/.test(ua)) {
                switchInstallTab('android');
            } else {
                switchInstallTab('desktop');
            }
        }

        // فتح نافذة إرشادات التثبيت
        function handleInstallClick() {
            const modal = document.getElementById('installGuideModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            lucide.createIcons();
        }

        function closeInstallModal() {
            const modal = document.getElementById('installGuideModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        async function triggerNativeInstall() {
            if (!deferredInstallPrompt) return;
            deferredInstallPrompt.prompt();
            const { outcome } = await deferredInstallPrompt.userChoice;
            if (outcome === 'accepted') {
                showToast('جاري تثبيت التطبيق كأيقونة على جهازك...', 'success');
                closeInstallModal();
            }
            deferredInstallPrompt = null;
        }

        function switchInstallTab(platform) {
            ['android', 'ios', 'desktop'].forEach(p => {
                const tabBtn = document.getElementById(`tab-${p}`);
                const guideBox = document.getElementById(`guide-${p}`);
                if (p === platform) {
                    tabBtn.className = 'py-2 px-2 rounded-lg bg-white text-primary-700 shadow-xs transition flex items-center justify-center gap-1.5';
                    guideBox.classList.remove('hidden');
                } else {
                    tabBtn.className = 'py-2 px-2 rounded-lg text-slate-600 hover:text-slate-900 transition flex items-center justify-center gap-1.5';
                    guideBox.classList.add('hidden');
                }
            });
        }

        // تحميل البيانات من localStorage
        function loadStudents() {
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                if (saved) {
                    students = JSON.parse(saved);
                } else {
                    students = [...sampleStudentsData];
                    saveStudents();
                }
            } catch (error) {
                console.error('خطأ أثناء قراءة البيانات:', error);
                students = [];
            }
        }

        // حفظ البيانات تلقائياً في localStorage
        function saveStudents() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(students));
                updateStats();
            } catch (error) {
                showToast('تعذر حفظ البيانات في ذاكرة المتصفح', 'error');
            }
        }

        // استيراد بيانات تجريبية
        function loadSampleData() {
            let addedCount = 0;
            sampleStudentsData.forEach(sample => {
                const exists = students.some(s => s.studentId === sample.studentId);
                if (!exists) {
                    students.unshift({ ...sample, id: Date.now().toString() + Math.random().toString(36).slice(2, 6) });
                    addedCount++;
                }
            });

            if (addedCount > 0) {
                saveStudents();
                renderTable();
                showToast(`تم استيراد ${addedCount} سجلات تجريبية بنجاح`, 'success');
            } else {
                showToast('البيانات التجريبية موجودة بالفعل في السجل', 'info');
            }
        }

        // معالجة حفظ / تعديل بيانات الطالب
        document.getElementById('studentForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const editId = document.getElementById('editStudentId').value;
            const fullName = document.getElementById('fullName').value.trim();
            const studentId = document.getElementById('studentId').value.trim();
            const gradeLevel = document.getElementById('gradeLevel').value;
            const major = document.getElementById('major').value.trim();
            const gpa = parseFloat(document.getElementById('gpa').value);
            const phone = document.getElementById('phone').value.trim();
            const notes = document.getElementById('notes').value.trim();

            const isDuplicate = students.some(s => s.studentId === studentId && s.id !== editId);
            if (isDuplicate) {
                showToast('هذا الرقم الأكاديمي مسجل لطالب آخر بالفعل!', 'error');
                document.getElementById('studentId').focus();
                return;
            }

            if (editId) {
                const index = students.findIndex(s => s.id === editId);
                if (index !== -1) {
                    students[index] = { ...students[index], fullName, studentId, gradeLevel, major, gpa, phone, notes };
                    showToast('تم تحديث بيانات الطالب بنجاح', 'success');
                }
            } else {
                students.unshift({
                    id: Date.now().toString(),
                    fullName,
                    studentId,
                    gradeLevel,
                    major,
                    gpa,
                    phone,
                    notes
                });
                showToast('تمت إضافة الطالب وحفظه تلقائياً', 'success');
            }

            saveStudents();
            resetForm();
            renderTable();
        });

        // تعبئة النموذج للتعديل
        function editStudent(id) {
            const student = students.find(s => s.id === id);
            if (!student) return;

            document.getElementById('editStudentId').value = student.id;
            document.getElementById('fullName').value = student.fullName;
            document.getElementById('studentId').value = student.studentId;
            document.getElementById('gradeLevel').value = student.gradeLevel;
            document.getElementById('major').value = student.major;
            document.getElementById('gpa').value = student.gpa;
            document.getElementById('phone').value = student.phone;
            document.getElementById('notes').value = student.notes || '';

            document.getElementById('formTitle').textContent = 'تعديل بيانات الطالب';
            document.getElementById('submitBtnText').textContent = 'حفظ التعديلات';
            document.getElementById('submitBtn').classList.remove('bg-primary-600', 'hover:bg-primary-700');
            document.getElementById('submitBtn').classList.add('bg-amber-600', 'hover:bg-amber-700');
            document.getElementById('cancelEditBtn').classList.remove('hidden');

            document.getElementById('studentForm').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // إعادة ضبط النموذج
        function resetForm() {
            document.getElementById('studentForm').reset();
            document.getElementById('editStudentId').value = '';
            document.getElementById('formTitle').textContent = 'إضافة طالب جديد';
            document.getElementById('submitBtnText').textContent = 'حفظ بيانات الطالب';
            document.getElementById('submitBtn').classList.add('bg-primary-600', 'hover:bg-primary-700');
            document.getElementById('submitBtn').classList.remove('bg-amber-600', 'hover:bg-amber-700');
            document.getElementById('cancelEditBtn').classList.add('hidden');
        }

        // تأكيد حذف طالب واحد
        function promptDelete(id) {
            const student = students.find(s => s.id === id);
            if (!student) return;

            deleteMode = 'single';
            studentIdToDelete = id;
            document.getElementById('deleteModalTitle').textContent = 'تأكيد حذف سجل الطالب';
            document.getElementById('deleteModalMessage').innerHTML = `هل أنت متأكد من حذف بيانات الطالب <strong class="text-slate-900">"${escapeHTML(student.fullName)}"</strong>؟ لا يمكن التراجع عن هذه العملية.`;
            
            const modal = document.getElementById('deleteModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        // تأكيد مسح جميع البيانات
        function promptClearAll() {
            if (students.length === 0) {
                showToast('السجل فارغ بالفعل', 'info');
                return;
            }
            deleteMode = 'all';
            studentIdToDelete = null;
            document.getElementById('deleteModalTitle').textContent = 'مسح جميع سجلات الطلاب';
            document.getElementById('deleteModalMessage').textContent = `سيتم حذف جميع الطلاب المسجلين (${students.length} طلاب) من ذاكرة التطبيق نهائياً. هل تود المتابعة؟`;
            
            const modal = document.getElementById('deleteModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeDeleteModal() {
            studentIdToDelete = null;
            const modal = document.getElementById('deleteModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', () => {
            if (deleteMode === 'all') {
                students = [];
                resetForm();
                saveStudents();
                renderTable();
                closeDeleteModal();
                showToast('تم مسح جميع السجلات بنجاح', 'info');
                return;
            }

            if (!studentIdToDelete) return;
            students = students.filter(s => s.id !== studentIdToDelete);
            if (document.getElementById('editStudentId').value === studentIdToDelete) {
                resetForm();
            }

            saveStudents();
            renderTable();
            closeDeleteModal();
            showToast('تم حذف سجل الطالب', 'info');
        });

        // شارة التقدير والمعدل
        function getGradeBadge(gpa) {
            if (gpa >= 90) {
                return `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">${gpa}% ممتاز</span>`;
            } else if (gpa >= 80) {
                return `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">${gpa}% جيد جداً</span>`;
            } else if (gpa >= 65) {
                return `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">${gpa}% جيد</span>`;
            } else if (gpa >= 50) {
                return `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">${gpa}% مقبول</span>`;
            } else {
                return `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">${gpa}% راسب</span>`;
            }
        }

        // عرض الجدول وتحديثه
        function renderTable() {
            const tbody = document.getElementById('studentsTableBody');
            const emptyState = document.getElementById('emptyState');
            const searchQuery = document.getElementById('searchInput').value.trim().toLowerCase();
            const stageFilter = document.getElementById('filterStage').value;

            const filteredStudents = students.filter(student => {
                const matchesSearch = 
                    student.fullName.toLowerCase().includes(searchQuery) ||
                    student.studentId.toLowerCase().includes(searchQuery) ||
                    student.major.toLowerCase().includes(searchQuery) ||
                    (student.notes && student.notes.toLowerCase().includes(searchQuery));
                
                const matchesStage = stageFilter === 'all' || student.gradeLevel === stageFilter;
                return matchesSearch && matchesStage;
            });

            tbody.innerHTML = '';

            if (filteredStudents.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');

                filteredStudents.forEach(student => {
                    const tr = document.createElement('tr');
